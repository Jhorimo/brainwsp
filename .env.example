# Core
NODE_ENV=development
DATABASE_URL=postgresql://brainwsp:brainwsp@localhost:5432/brainwsp?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
# Límite de tamaño de body JSON/urlencoded (adjuntos van en base64 dentro del JSON).
BODY_LIMIT=25mb
WEB_ORIGIN=http://localhost:3000
# Orígenes extra (además de WEB_ORIGIN) que el API debe aceptar por CORS/WebSocket,
# separados por coma. Solo usado por deploy.sh para armar WEB_ORIGIN en producción.
EXTRA_WEB_ORIGINS=
JWT_SECRET=change-this-with-at-least-64-random-characters
JWT_TTL=12h
CREDENTIAL_HASH_PEPPER=change-this-pepper-too
# Cifra el AUTH KEY para poder mostrarlo de nuevo desde el panel ("ver AUTH KEY").
# Cambiar esta llave invalida la capacidad de ver AUTH KEYs ya guardados (no la autenticación).
CREDENTIAL_ENCRYPTION_KEY=change-this-encryption-key-too

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Dominio público del panel — usado para el link canónico, Open Graph, robots.txt y el
# sitemap de la landing (ver apps/web/app/page.tsx, robots.ts, sitemap.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Worker
# Optional: only set this when every worker receives a unique value.
# WORKER_ID=wa-worker-local-01
WORKER_CONCURRENCY=20
LOG_LEVEL=info

# Agente IA (opcional): sin ANTHROPIC_API_KEY, el agente IA queda inactivo aunque se
# active el interruptor por conversación en el panel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google (opcional): mismo cliente OAuth "Aplicación web" para dos usos independientes —
# sin GOOGLE_CLIENT_ID/SECRET ambos quedan inactivos. Agregar TANTO
# GOOGLE_REDIRECT_URI como GOOGLE_AUTH_REDIRECT_URI como URIs de redirección autorizados
# en Google Cloud Console (deben apuntar al backend, no al panel).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Módulo Calendario: agendar citas en el Google Calendar que cada empresa conecta.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback
# "Ingresar / registrarse con Google" en /login.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Seed (development only)
SEED_COMPANY_NAME=Brain Tech Peru
SEED_COMPANY_SLUG=brain-tech-peru
SEED_ADMIN_NAME=Administrador Brain Tech
SEED_ADMIN_EMAIL=admin@braintech.com.pe
SEED_ADMIN_PASSWORD=ChangeMe-123456!
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@braintech.com.pe
SEED_SUPERADMIN_PASSWORD=SuperAdmin-123456!
