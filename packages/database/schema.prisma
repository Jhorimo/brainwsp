generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum WhatsAppProvider {
  BAILEYS
  META_CLOUD
}

enum InstanceStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  RECONNECTING
  LOGGED_OUT
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
}

enum FeedbackType {
  SUGGESTION
  BUG
  OTHER
}

enum FeedbackStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum IncidentStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model Company {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  active         Boolean            @default(true)
  aiSystemPrompt String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  users          User[]
  apiCredentials ApiCredential[]
  instances      WhatsAppInstance[]
  departments    Department[]
  projects       Project[]
  contacts       Contact[]
  conversations  Conversation[]
  messages       Message[]
  messageReactions MessageReaction[]
  quickReplies   QuickReply[]
  webhooks       Webhook[]
  auditLogs      AuditLog[]
  feedback       Feedback[]
  incidents      Incident[]
  tags           Tag[]
  knowledgeEntries KnowledgeEntry[]
  stickers       StickerItem[]
}

model User {
  id                   String          @id @default(uuid())
  companyId            String
  email                String          @unique
  name                 String
  passwordHash         String
  role                 UserRole        @default(AGENT)
  active               Boolean         @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]  @relation("AssignedAgent")
  departments          DepartmentUser[]
  feedback             Feedback[]
  createdIncidents     Incident[]      @relation("IncidentCreatedBy")

  @@index([companyId])
}

model ApiCredential {
  id         String            @id @default(uuid())
  companyId  String
  instanceId String?
  name       String
  appKey     String            @unique
  authHash   String
  active     Boolean           @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance   WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([instanceId])
}

model WhatsAppInstance {
  id               String           @id @default(uuid())
  companyId        String
  name             String
  slug             String
  provider         WhatsAppProvider @default(BAILEYS)
  phoneNumber      String?
  displayName      String?
  status           InstanceStatus   @default(DISCONNECTED)
  qr               String?
  reconnectAttempt Int              @default(0)
  lastError        String?
  lastConnectedAt  DateTime?
  lastDisconnectedAt DateTime?
  active           Boolean          @default(true)
  autoConnect      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiCredentials   ApiCredential[]
  conversations    Conversation[]
  messages         Message[]
  authCredential   WhatsAppAuthCredential?
  authKeys         WhatsAppAuthKey[]

  @@unique([companyId, slug])
  @@index([companyId, status])
}

model WhatsAppAuthCredential {
  instanceId String   @id
  data       String   @db.Text
  updatedAt  DateTime @updatedAt
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model WhatsAppAuthKey {
  id         String   @id @default(uuid())
  instanceId String
  type       String
  keyId      String
  data       String   @db.Text
  updatedAt  DateTime @updatedAt
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, type, keyId])
  @@index([instanceId, type])
}

model Department {
  id          String           @id @default(uuid())
  companyId   String
  name        String
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       DepartmentUser[]
  conversations Conversation[]
  feedback    Feedback[]
  incidents   Incident[]

  @@unique([companyId, name])
}

model DepartmentUser {
  departmentId String
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([departmentId, userId])
}

model Project {
  id            String         @id @default(uuid())
  companyId     String
  name          String
  description   String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([companyId, name])
}

model Contact {
  id            String         @id @default(uuid())
  companyId     String
  waId          String
  phone         String?
  name          String?
  pushName      String?
  avatarUrl     String?
  email         String?
  notes         String?        @db.Text
  leadStage     LeadStage      @default(NEW)
  metadata      Json?
  lastSeenAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  authoredMessages Message[]   @relation("MessageAuthor")
  reactions     MessageReaction[]
  tags          ContactTag[]

  @@unique([companyId, waId])
  @@index([companyId, phone])
}

model Tag {
  id        String       @id @default(uuid())
  companyId String
  name      String
  color     String       @default("#6b8afd")
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([companyId, name])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// Kept intentionally simple — plain title/content entries stuffed into the AI's system
// prompt (see apps/worker/src/ai-agent.ts), not a vector-embedding search. Good enough for
// the handful of FAQs a small business support inbox actually needs; revisit with
// pgvector + embeddings if the entry count grows large enough to blow the context budget.
model KnowledgeEntry {
  id        String   @id @default(uuid())
  companyId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Conversation {
  id             String             @id @default(uuid())
  companyId      String
  instanceId     String
  contactId      String
  assignedUserId String?
  departmentId   String?
  projectId      String?
  status         ConversationStatus @default(OPEN)
  subject        String?
  aiEnabled      Boolean            @default(false)
  pinned         Boolean            @default(false)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance       WhatsAppInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser   User?              @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages       Message[]
  incidents      Incident[]

  @@unique([instanceId, contactId])
  @@index([companyId, status, lastMessageAt])
  @@index([assignedUserId, status])
}

model Message {
  id             String           @id @default(uuid())
  companyId      String
  conversationId String
  instanceId     String
  contactId      String
  waMessageId    String           @default(uuid())
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  status         MessageStatus
  body           String?          @db.Text
  mediaUrl       String?          @db.Text
  fileName       String?
  fileSize       Int?
  mimeType       String?
  caption        String?          @db.Text
  error          String?          @db.Text
  metadata       Json?
  authorContactId String?
  pinned         Boolean          @default(false)
  starred        Boolean          @default(false)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  instance       WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author         Contact?         @relation("MessageAuthor", fields: [authorContactId], references: [id], onDelete: SetNull)
  reactions      MessageReaction[]

  @@unique([instanceId, waMessageId])
  @@index([conversationId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([authorContactId])
}

// One row per person reacting to a message, keyed by their WhatsApp JID rather than
// Contact — the reactor's Contact row may not exist/resolve (e.g. business's own
// reactions), but the JID is always present and is what WhatsApp itself deduplicates on
// (a person has at most one active reaction per message; an empty `reaction.text` from
// Baileys means "removed", handled by deleting this row rather than storing it empty).
model MessageReaction {
  id         String   @id @default(uuid())
  messageId  String
  companyId  String
  reactorJid String
  fromMe     Boolean  @default(false)
  contactId  String?
  emoji      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorJid])
  @@index([contactId])
}

// A shared, reusable "sticker tray" for the company, mirroring WhatsApp's own picker —
// upload once, then click to send to any conversation instead of re-attaching a file
// every time. Media itself (already converted to webp) lives in MinIO, same as message
// attachments; this just indexes it for the tray UI.
model StickerItem {
  id        String   @id @default(uuid())
  companyId String
  mediaUrl  String   @db.Text
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model QuickReply {
  id        String   @id @default(uuid())
  companyId String
  shortcut  String
  title     String
  content   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, shortcut])
}

model Webhook {
  id        String   @id @default(uuid())
  companyId String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model Feedback {
  id           String         @id @default(uuid())
  companyId    String
  userId       String
  departmentId String?
  type         FeedbackType   @default(SUGGESTION)
  status       FeedbackStatus @default(PENDING)
  subject      String
  message      String         @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

model Incident {
  id              String         @id @default(uuid())
  companyId       String
  conversationId  String
  departmentId    String
  createdByUserId String
  type            FeedbackType   @default(BUG)
  status          IncidentStatus @default(PENDING)
  subject         String
  message         String         @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([departmentId, status])
}
