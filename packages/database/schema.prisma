generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
}

enum WhatsAppProvider {
  BAILEYS
  META_CLOUD
}

enum InstanceStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  RECONNECTING
  LOGGED_OUT
  ERROR
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}


enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  UNKNOWN
}

enum MessageStatus {
  RECEIVED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
}

enum FeedbackType {
  SUGGESTION
  BUG
  OTHER
}

enum FeedbackStatus {
  PENDING
  IN_REVIEW
  RESOLVED
}

enum IncidentStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum LeadStatus {
  NONE
  COLD
  INTERESTED
  VERY_INTERESTED
}

enum FlowTriggerType {
  KEYWORD
}

enum FlowExecutionStatus {
  RUNNING
  WAITING_INPUT
  WAITING_TIMER
  COMPLETED
  CANCELLED
}

model Company {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  active         Boolean            @default(true)
  phone          String?
  planId         String?
  licenseRenewsAt DateTime?
  aiSystemPrompt String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  plan           Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  users          User[]
  apiCredentials ApiCredential[]
  instances      WhatsAppInstance[]
  departments    Department[]
  projects       Project[]
  contacts       Contact[]
  conversations  Conversation[]
  messages       Message[]
  messageReactions MessageReaction[]
  quickReplies   QuickReply[]
  webhooks       Webhook[]
  auditLogs      AuditLog[]
  feedback       Feedback[]
  incidents      Incident[]
  tags           Tag[]
  knowledgeEntries KnowledgeEntry[]
  stickers       StickerItem[]
  pipelineStages PipelineStage[]
  leads          Lead[]
  deals          Deal[]
  googleCalendar GoogleCalendarIntegration?
  calendarEvents CalendarEvent[]
  flowFolders    FlowFolder[]
  flows          Flow[]
  flowExecutions FlowExecution[]
}

// Platform-level catalog, managed by SUPERADMIN users — not scoped to any one company.
// A company's current plan is just `Company.planId`; this is the sellable catalog it
// picks from (name, price, limits), analogous to Brain Tech's other SaaS products.
model Plan {
  id           String    @id @default(uuid())
  name         String    @unique
  billingCycle String    @default("MONTHLY")
  price        Int       @default(0)
  priceUsd     Int       @default(0)
  maxAgents    Int?
  maxInstances Int?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  companies    Company[]
}

model User {
  id                   String          @id @default(uuid())
  companyId            String
  email                String          @unique
  name                 String
  passwordHash         String?
  googleId             String?         @unique
  role                 UserRole        @default(AGENT)
  active               Boolean         @default(true)
  allowedModules       String[]        @default([])
  lastLoginAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]  @relation("AssignedAgent")
  departments          DepartmentUser[]
  feedback             Feedback[]
  createdIncidents     Incident[]      @relation("IncidentCreatedBy")
  sentMessages         Message[]       @relation("MessageSentBy")
  auditLogs            AuditLog[]
  assignedLeads        Lead[]          @relation("LeadAssignee")
  assignedDeals        Deal[]          @relation("DealAssignee")
  connectedCalendars   GoogleCalendarIntegration[]
  createdCalendarEvents CalendarEvent[]
  createdFlows         Flow[]

  @@index([companyId])
}

model ApiCredential {
  id         String           @id @default(uuid())
  companyId  String
  // Opcional: la credencial maestra que se crea al registrar la empresa no pertenece a
  // una instancia. Su AUTH KEY permite que POST /api/user/device aprovisione múltiples
  // instancias, cada una con una credencial hija y APP KEY propio. Las credenciales
  // creadas manualmente desde el panel sí requieren una instancia existente.
  instanceId String?
  name       String
  appKey     String           @unique
  authHash   String
  // Copia reversible (AES-256-GCM) del AUTH KEY, solo para poder mostrarlo de nuevo
  // desde el panel. `authHash` sigue siendo lo único que autentica peticiones entrantes.
  // Nula en credenciales creadas antes de esta función — hay que regenerarlas para verlas.
  authKeyEncrypted String?
  active     Boolean          @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cada instancia tiene como máximo una credencial (1:1) — borrar la
  // instancia se lleva su credencial con ella, ya no tiene sentido sola.
  instance   WhatsAppInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@unique([instanceId])
  @@index([companyId])
}

model WhatsAppInstance {
  id               String           @id @default(uuid())
  companyId        String
  name             String
  slug             String
  provider         WhatsAppProvider @default(BAILEYS)
  phoneNumber      String?
  displayName      String?
  // Datos del cliente BrainPOS Restaurante que creó esta instancia vía POST
  // /api/user/device. Varias instalaciones pueden compartir dominio/IP, por lo que la
  // identidad estable combina el webhook normalizado con el teléfono declarado.
  posWebhookUrl    String?
  posClientKey     String?
  status           InstanceStatus   @default(DISCONNECTED)
  qr               String?
  reconnectAttempt Int              @default(0)
  lastError        String?
  lastConnectedAt  DateTime?
  lastDisconnectedAt DateTime?
  active           Boolean          @default(true)
  autoConnect      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  apiCredential    ApiCredential?
  conversations    Conversation[]
  messages         Message[]
  authCredential   WhatsAppAuthCredential?
  authKeys         WhatsAppAuthKey[]
  flows            Flow[]

  @@unique([companyId, slug])
  @@unique([companyId, posClientKey])
  @@index([companyId, status])
}

model WhatsAppAuthCredential {
  instanceId String   @id
  data       String   @db.Text
  updatedAt  DateTime @updatedAt
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model WhatsAppAuthKey {
  id         String   @id @default(uuid())
  instanceId String
  type       String
  keyId      String
  data       String   @db.Text
  updatedAt  DateTime @updatedAt
  instance   WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, type, keyId])
  @@index([instanceId, type])
}

model Department {
  id          String           @id @default(uuid())
  companyId   String
  name        String
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       DepartmentUser[]
  conversations Conversation[]
  feedback    Feedback[]
  incidents   Incident[]
  stages      PipelineStage[]
  leads       Lead[]
  deals       Deal[]

  @@unique([companyId, name])
}

// A department's own sales/case pipeline — Ventas might use Nuevo→Contactado→Ganado/Perdido
// while Cobranzas uses Pendiente→Pagado→Moroso. Deliberately scoped to one department (not
// nullable/company-wide) so there's no ambiguous "general pipeline" fallback to reason
// about: a conversation with no department simply has no stages to pick from.
model PipelineStage {
  id           String        @id @default(uuid())
  companyId    String
  departmentId String
  name         String
  color        String        @default("#6b8afd")
  order        Int           @default(0)
  isWon        Boolean       @default(false)
  createdAt    DateTime      @default(now())
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  deals        Deal[]

  @@unique([departmentId, name])
  @@index([companyId])
}

model DepartmentUser {
  departmentId String
  userId       String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([departmentId, userId])
}

model Project {
  id            String         @id @default(uuid())
  companyId     String
  name          String
  description   String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([companyId, name])
}

model Contact {
  id            String         @id @default(uuid())
  companyId     String
  waId          String
  phone         String?
  name          String?
  pushName      String?
  avatarUrl     String?
  email         String?
  notes         String?        @db.Text
  metadata      Json?
  lastSeenAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  authoredMessages Message[]   @relation("MessageAuthor")
  reactions     MessageReaction[]
  tags          ContactTag[]
  leads         Lead[]
  deals         Deal[]
  calendarEvents CalendarEvent[]

  @@unique([companyId, waId])
  @@index([companyId, phone])
}

model Tag {
  id        String       @id @default(uuid())
  companyId String
  name      String
  color     String       @default("#6b8afd")
  createdAt DateTime     @default(now())
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]
  deals     DealTag[]

  @@unique([companyId, name])
}

model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// Kept intentionally simple — plain title/content entries stuffed into the AI's system
// prompt (see apps/worker/src/ai-agent.ts), not a vector-embedding search. Good enough for
// the handful of FAQs a small business support inbox actually needs; revisit with
// pgvector + embeddings if the entry count grows large enough to blow the context budget.
model KnowledgeEntry {
  id        String   @id @default(uuid())
  companyId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Conversation {
  id             String             @id @default(uuid())
  companyId      String
  instanceId     String
  contactId      String
  assignedUserId String?
  departmentId   String?
  projectId      String?
  stageId        String?
  status         ConversationStatus @default(OPEN)
  subject        String?
  aiEnabled      Boolean            @default(false)
  pinned         Boolean            @default(false)
  unreadCount    Int                @default(0)
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  instance       WhatsAppInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact        Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser   User?              @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  department     Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  stage          PipelineStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  messages       Message[]
  incidents      Incident[]
  leads          Lead[]
  deals          Deal[]
  calendarEvents CalendarEvent[]
  flowExecutions FlowExecution[]

  @@unique([instanceId, contactId])
  @@index([companyId, status, lastMessageAt])
  @@index([assignedUserId, status])
  @@index([companyId, departmentId])
}

model Message {
  id             String           @id @default(uuid())
  companyId      String
  conversationId String
  instanceId     String
  contactId      String
  waMessageId    String           @default(uuid())
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  status         MessageStatus
  body           String?          @db.Text
  mediaUrl       String?          @db.Text
  fileName       String?
  fileSize       Int?
  mimeType       String?
  caption        String?          @db.Text
  error          String?          @db.Text
  metadata       Json?
  authorContactId String?
  // Which internal agent (User) sent an OUTBOUND message from the panel — null for inbound
  // messages, API-key/legacy-integration sends, and AI auto-replies, since none of those
  // are a human agent. Powers the per-agent KPI report on the dashboard.
  sentByUserId   String?
  quotedMessageId String?
  pinned         Boolean          @default(false)
  starred        Boolean          @default(false)
  // "Eliminar" (delete for everyone), WhatsApp Web style. Original content is kept in the
  // fields above for audit purposes — this only controls whether the panel renders the
  // real content or a "mensaje eliminado" placeholder.
  deleted        Boolean          @default(false)
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  instance       WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author         Contact?         @relation("MessageAuthor", fields: [authorContactId], references: [id], onDelete: SetNull)
  sentByUser     User?            @relation("MessageSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  reactions      MessageReaction[]
  // "Responder" (reply-to/quote), WhatsApp Web style. Self-relation is nullable + SetNull
  // so deleting the quoted message never cascades into deleting the reply that quotes it.
  quotedMessage  Message?         @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  quotedBy       Message[]        @relation("MessageQuote")

  @@unique([instanceId, waMessageId])
  @@index([conversationId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([companyId, direction, createdAt])
  @@index([companyId, sentByUserId, createdAt])
  @@index([authorContactId])
  @@index([quotedMessageId])
}

// One row per person reacting to a message, keyed by their WhatsApp JID rather than
// Contact — the reactor's Contact row may not exist/resolve (e.g. business's own
// reactions), but the JID is always present and is what WhatsApp itself deduplicates on
// (a person has at most one active reaction per message; an empty `reaction.text` from
// Baileys means "removed", handled by deleting this row rather than storing it empty).
model MessageReaction {
  id         String   @id @default(uuid())
  messageId  String
  companyId  String
  reactorJid String
  fromMe     Boolean  @default(false)
  contactId  String?
  emoji      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([messageId, reactorJid])
  @@index([contactId])
}

// A shared, reusable "sticker tray" for the company, mirroring WhatsApp's own picker —
// upload once, then click to send to any conversation instead of re-attaching a file
// every time. Media itself (already converted to webp) lives in MinIO, same as message
// attachments; this just indexes it for the tray UI.
model StickerItem {
  id        String   @id @default(uuid())
  companyId String
  mediaUrl  String   @db.Text
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model QuickReply {
  id        String   @id @default(uuid())
  companyId String
  shortcut  String
  title     String
  content   String?  @db.Text
  active    Boolean  @default(true)
  mediaUrl  String?  @db.Text
  fileName  String?
  mimeType  String?
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, shortcut])
}

model Webhook {
  id        String   @id @default(uuid())
  companyId String
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
}

// One shared Google account per company (connected by an OWNER/ADMIN from the Calendario
// module) — every agent schedules into the same calendar, not a personal one. Tokens are
// stored AES-256-GCM encrypted (see common/utils/secret.ts, same scheme already used for
// AUTH KEYs) since the refresh token alone grants standing access to that Google Calendar.
model GoogleCalendarIntegration {
  companyId         String   @id
  googleEmail       String?
  accessToken       String   @db.Text
  refreshToken      String   @db.Text
  tokenExpiresAt    DateTime
  calendarId        String   @default("primary")
  connectedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedByUser   User?    @relation(fields: [connectedByUserId], references: [id], onDelete: SetNull)
}

// An appointment scheduled ("Agendar cita") from a conversation, mirrored into the
// company's Google Calendar. `googleEventId` is what lets us cancel it on Google too when
// the appointment is deleted here.
model CalendarEvent {
  id              String        @id @default(uuid())
  companyId       String
  conversationId  String?
  contactId       String?
  googleEventId   String
  title           String
  description     String?       @db.Text
  location        String?
  startAt         DateTime
  endAt           DateTime
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdByUser   User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, startAt])
  @@index([conversationId])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([createdAt])
}

model Feedback {
  id           String         @id @default(uuid())
  companyId    String
  userId       String
  departmentId String?
  type         FeedbackType   @default(SUGGESTION)
  status       FeedbackStatus @default(PENDING)
  subject      String
  message      String         @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

model Incident {
  id              String         @id @default(uuid())
  companyId       String
  conversationId  String
  departmentId    String
  createdByUserId String
  type            FeedbackType   @default(BUG)
  status          IncidentStatus @default(PENDING)
  subject         String
  message         String         @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation    Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  department      Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("IncidentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([departmentId, status])
}

// --- CRM (Prospectos / Tratos / Pipelines) ---
// Fusionado con el pipeline por departamento de arriba (`PipelineStage`, usado también por
// `Conversation`): cada Departamento ES un Pipeline de CRM, y sus Etapas son las mismas que
// se gestionan en "Equipo y agentes → Etapas". No hay un pipeline de ventas separado.

// Un prospecto entrante, antes de convertirse en trato. Puede venir de una conversación de
// WhatsApp (contactId/conversationId) o de otro canal/carga manual (sin ninguno de los dos).
// Sin departamento todavía al llegar — se asigna a mano o hereda el de la conversación.
model Lead {
  id              String        @id @default(uuid())
  companyId       String
  departmentId    String?
  title           String
  personName      String?
  personEmail     String?
  personPhone     String?
  companyName     String?
  status          LeadStatus    @default(NONE)
  channel         String?
  source          String?
  score           Int?
  value           Int?
  assignedUserId  String?
  contactId       String?
  conversationId  String?
  convertedDealId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedUser    User?         @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  convertedDeal   Deal?         @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, departmentId])
}

model Deal {
  id              String        @id @default(uuid())
  companyId       String
  departmentId    String
  title           String
  value           Int?          @default(0)
  stageId         String
  probability     Int?
  expectedCloseAt DateTime?
  assignedUserId  String?
  companyName     String?
  personName      String?
  personEmail     String?
  personPhone     String?
  contactId       String?
  conversationId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Sin onDelete: SetNull en departamento/etapa — un trato siempre necesita ambos.
  // TeamService.deleteDepartment/deleteStage rechazan borrar mientras tengan tratos.
  department      Department    @relation(fields: [departmentId], references: [id])
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  assignedUser    User?         @relation("DealAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  tags            DealTag[]
  fromLead        Lead?         @relation("LeadConvertedDeal")

  @@index([companyId, departmentId, stageId])
}

model DealTag {
  dealId String
  tagId  String
  deal   Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dealId, tagId])
}

// --- Automatizaciones (Flow Builder) ---
// Carpeta simple para organizar flujos (mismo patrón que Department/Project): una entidad
// propia en vez de un string suelto, así el combobox "creatable" del formulario de creación
// no genera duplicados por mayúsculas/typos y renombrarla afecta a todos sus flujos a la vez.
model FlowFolder {
  id        String   @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flows     Flow[]

  @@unique([companyId, name])
  @@index([companyId])
}

// La definición visual de una automatización. El diagrama completo (nodos + conexiones) se
// guarda como un solo JSON en `graph` en vez de normalizar nodos/edges en tablas — así el
// editor visual solo serializa/deserializa y agregar un tipo de nodo nuevo no pide migración
// (mismo enfoque que usan n8n/Typebot). `graph.schemaVersion` permite migrar el formato hacia
// adelante si el shape cambia más adelante.
model Flow {
  id              String           @id @default(uuid())
  companyId       String
  folderId        String?
  name            String
  triggerType     FlowTriggerType  @default(KEYWORD)
  triggerKeywords String[]         @default([])
  active          Boolean          @default(true)
  graph           Json
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Un flujo puede correr sobre uno o varios bots (instancias de WhatsApp) de la empresa —
  // "Compartir" en el panel agrega/quita instancias de esta lista. m:n implícita (sin campos
  // propios en la relación, así que no hace falta un modelo de tabla intermedia aparte).
  instances       WhatsAppInstance[]
  folder          FlowFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  executions      FlowExecution[]

  @@index([companyId, active])
  @@index([folderId])
}

// Estado de una corrida del flujo para UNA conversación puntual — máquina de estados: guarda
// en qué nodo va (`currentNodeId`) y las variables recolectadas (`context`), para poder
// retomar la ejecución cuando llegue el siguiente mensaje o se dispare un timer, en vez de
// tener que rehacer el flujo desde el nodo inicial. El worker (apps/worker/automation-engine.ts)
// crea una fila aquí por cada ejecución real en WhatsApp. El simulador del editor NO pasa por
// aquí — corre el mismo motor pero de forma efímera (ver AutomationsService.simulate), para no
// ensuciar esta tabla con corridas de prueba.
model FlowExecution {
  id             String              @id @default(uuid())
  companyId      String
  flowId         String
  conversationId String
  currentNodeId  String?
  status         FlowExecutionStatus @default(RUNNING)
  context        Json                @default("{}")
  waitingUntil   DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flow           Flow                @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([conversationId, status])
}
